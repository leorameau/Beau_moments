---
// Routeur unique : génère toutes les pages du site dans les trois langues, avec des adresses
// traduites (ex. /catering/, /fr/traiteur/, /en/catering/).
// Les adresses viennent de src/i18n/routes.ts ; le contenu de src/views/.
import Home from '../views/Home.astro';
import Catering from '../views/Catering.astro';
import Atelier from '../views/Atelier.astro';
import Takeaway from '../views/Takeaway.astro';
import Gallery from '../views/Gallery.astro';
import About from '../views/About.astro';
import Legal from '../views/Legal.astro';
import { langs } from '../i18n/locales';
import { pages, type PageKey } from '../i18n/routes';

export function getStaticPaths() {
  const toParam = (p: string) => p.replace(/^\/|\/$/g, '') || undefined;
  const out: { params: { path: string | undefined }; props: Record<string, unknown> }[] = [];
  for (const lang of langs) {
    for (const key of Object.keys(pages) as PageKey[]) {
      out.push({ params: { path: toParam(pages[key][lang]) }, props: { view: key, lang } });
    }
  }
  return out;
}

const { view, lang } = Astro.props as any;
---
{view === 'home' && <Home lang={lang} />}
{view === 'catering' && <Catering lang={lang} />}
{view === 'atelier' && <Atelier lang={lang} />}
{view === 'takeaway' && <Takeaway lang={lang} />}
{view === 'gallery' && <Gallery lang={lang} />}
{view === 'about' && <About lang={lang} />}
{view === 'legal' && <Legal lang={lang} />}
