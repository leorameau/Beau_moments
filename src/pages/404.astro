---
// Page affichée par Netlify quand une adresse n'existe pas (dans les trois langues, néerlandais en premier).
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { ui } from '../i18n/ui';
import { langs, localeInfo } from '../i18n/locales';
import { pagePath } from '../i18n/routes';
---
<Base lang="nl" title={ui.nl.meta.notFoundTitle} description={ui.nl.meta.notFoundDesc} noindex>
  <section class="nf pad">
    <div class="wrap">
      <Logo />
      <div class="nf-langs">
        {langs.map((l) => (
          <div lang={localeInfo[l].html}>
            {l === 'nl'
              ? <h1>{ui[l].notFound.title}</h1>
              : <p class="nf-t">{ui[l].notFound.title}</p>}
            <p class="muted">{ui[l].notFound.text}</p>
            <a class="btn" href={pagePath('home', l)}>{ui[l].common.backHome}</a>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
