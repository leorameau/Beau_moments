---
// Formulaire de demande complet, sur la page « Plan je moment » (src/views/Quote.astro) :
// texte, contacts et photo à gauche, formulaire sur une carte à droite (photo masquée sur téléphone).
import Photo from './Photo.astro';
import EnquiryForm from './EnquiryForm.astro';
import type { PhotoKey } from '../lib/photos';
import { site, tel, mailHref } from '../lib/site';
import type { Lang } from '../i18n/locales';
interface Props { lang: Lang; title: string; text: string; photo?: PhotoKey; preset?: number }
const { lang, title, text, photo, preset } = Astro.props;
---
<section class="enq" id="aanvraag">
  <div class="wrap"><div class="enq-in">
    <div class="enq-text">
      <h1>{title}</h1>
      <p>{text}</p>
      <p class="contacts">{site.contacts.map((x) => <a href={tel(x.phone)}>{x.name} {x.phone}</a>)}<a href={mailHref}>{site.email}</a></p>
    </div>
    {photo && <Photo name={photo} lang={lang} class="enq-photo" sizes="(min-width: 1300px) 380px, 30vw" />}
    <div class="sheet"><EnquiryForm lang={lang} preset={preset} /></div>
  </div></div>
</section>
