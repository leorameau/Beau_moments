---
// Questions fréquentes (accordéon). Les données structurées FAQPage sont ajoutées par la page.
import { nbsp } from '../lib/nbsp';
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((it) => (
    <details>
      <summary><div><span>{nbsp(it.q)}</span></div><i aria-hidden="true"></i></summary>
      <div class="faq-a"><p>{nbsp(it.a)}</p></div>
    </details>
  ))}
</div>
