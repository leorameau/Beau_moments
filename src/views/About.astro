---
// Over ons : Bert & Aude, leur histoire et leurs rôles.
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import PageHero from '../components/PageHero.astro';
import { site, abs } from '../lib/site';
import { pagePath, allLangs } from '../i18n/routes';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/locales';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const a = s.about;
const ld = [{
  '@type': 'AboutPage',
  url: abs(pagePath('about', lang)),
  about: { '@id': `${site.siteUrl}/#business` },
  mainEntity: [
    { '@type': 'Person', name: 'Bert', jobTitle: 'Chef', worksFor: { '@id': `${site.siteUrl}/#business` } },
    { '@type': 'Person', name: 'Aude', worksFor: { '@id': `${site.siteUrl}/#business` } },
  ],
}];
---
<Base lang={lang} title={s.meta.aboutTitle} description={s.meta.aboutDesc} alternates={allLangs((l) => pagePath('about', l))}
  section="about" breadcrumbs={[{ name: s.nav.about, path: pagePath('about', lang) }]} extraLd={ld} ogPhoto="bert-and-aude" enquiry={{ look: 'b', photo: 'serving-bubbles' }}>
  <PageHero lang={lang} label={a.label} title="Bert & Aude" lead={a.lead} cover="chef-plating" photo="bert-and-aude" pos="50% 45%">
    {a.story.slice(0, 2).map((p) => <p>{p}</p>)}
  </PageHero>
  <section class="pad"><div class="wrap split">
    <Photo name="bert-serving" lang={lang} sizes="(min-width: 640px) 44vw, 92vw" /><div><h2>{a.bertTitle}</h2><p>{a.bert}</p></div>
  </div></section>
  <section class="pad stone"><div class="wrap split flip">
    <Photo name="aude-with-guests" lang={lang} sizes="(min-width: 640px) 44vw, 92vw" /><div><h2>{a.audeTitle}</h2><p>{a.aude}</p></div>
  </div></section>
</Base>
