---
// Afhaal : un nouveau menu à emporter chaque semaine (commande par téléphone jusqu'au jeudi,
// retrait le vendredi à l'atelier) + l'offre « Afhaal Feestdagen 2026 » (publication Instagram du 20/11/2026).
import Base from '../layouts/Base.astro';
import { feest, feestSlides } from '../lib/feestdagen';
import { site, abs, telHref } from '../lib/site';
import { pagePath, allLangs } from '../i18n/routes';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/locales';
import Photo from '../components/Photo.astro';
import PageHero from '../components/PageHero.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const k = s.takeaway;
const ig = site.social.instagram;
const f = feest[lang];
// Offre des fêtes en données structurées (prix repris du texte affiché)
const num = (t: string) => t.replace(',', '.').match(/[\d.]+\d|\d/)![0];
const ld = [{
  '@type': 'OfferCatalog',
  '@id': `${site.siteUrl}/#feestdagen`,
  name: f.label,
  description: f.lead,
  url: `${abs(pagePath('takeaway', lang))}#feestdagen`,
  itemListElement: [...f.prices.map((p) => ({ name: p.name.replace(' *', ''), price: p.price })), ...f.classics].map((o) => ({
    '@type': 'Offer', name: o.name, price: num(o.price), priceCurrency: 'EUR', description: o.price,
    seller: { '@id': `${site.siteUrl}/#business` }, availabilityEnds: '2026-12-27',
  })),
}];
---
<Base lang={lang} title={s.meta.takeawayTitle} description={s.meta.takeawayDesc} alternates={allLangs((l) => pagePath('takeaway', l))}
  section="takeaway" breadcrumbs={[{ name: s.nav.takeaway, path: pagePath('takeaway', lang) }]} extraLd={ld} ogPhoto="feest-cover" enquiry={{ look: 'a', photo: 'flower-bites', preset: 5 }}>
  <PageHero lang={lang} label={k.label} title={k.title} lead={k.lead} cover="table-lemons" photo="egg-shrimp-garden" pos="50% 40%">
    <a class="btn fill" href={telHref}>{k.call} {site.phone}</a>
  </PageHero>
  <section class="pad wrap" id="feestdagen">
    <h2 class="head">{f.label}</h2>
    <div class="grid">{feestSlides.map((n) => <Photo name={n} lang={lang} sizes="(min-width: 800px) 22vw, 46vw" />)}</div>
    <div class="feest">
      <div>
        <h3>{f.menuTitle}</h3>
        <dl class="courses">{f.courses.map((c) => <div><dt>{c.name}</dt><dd>{c.dish}</dd></div>)}</dl>
        <ul class="prices" role="list">{f.prices.map((p) => <li><span>{p.name}</span><span>{p.price}</span></li>)}</ul>
        <p class="small">{f.fourNote}</p>
      </div>
      <div>
        <h3>{f.classicsTitle}</h3>
        <ul class="prices" role="list">{f.classics.map((c) => <li><span>{c.name}{c.note && <small> {c.note}</small>}</span><span>{c.price}</span></li>)}</ul>
        <h3>{f.orderTitle}</h3>
        <ul role="list">{f.order.map((o) => <li>{o}</li>)}</ul>
        <h3>{f.pickupTitle}</h3>
        <ul role="list">{f.pickup.map((o) => <li>{o}</li>)}</ul>
        <p class="acts"><a class="btn fill" href={`mailto:${site.takeawayEmail}`}>{f.orderCta}</a></p>
        <p class="small">{f.allergens}</p>
      </div>
    </div>
  </section>
  <section class="pad">
    <div class="wrap"><h2 class="head">{k.howTitle}</h2>
      <ol class="steps" role="list">{k.how.map((p, i) => <li><span class="num">{i + 1}</span><h3>{p.title}</h3><p>{p.text}</p></li>)}</ol>
      <p class="acts"><a class="btn" href={telHref}>{site.phone}</a><a class="btn ghost" href={ig.url} target="_blank" rel="noopener">{k.follow}</a></p>
    </div>
  </section>
</Base>
