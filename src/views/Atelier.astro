---
// Atelier : private dining à Maldegem (8 à 18 personnes), adresse, contact, FAQ.
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { site } from '../lib/site';
import { pagePath, allLangs } from '../i18n/routes';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/locales';
import Photo from '../components/Photo.astro';
import PageHero from '../components/PageHero.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const a = s.atelier;
const ld = [{ '@type': 'FAQPage', mainEntity: a.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }];
---
<Base lang={lang} title={s.meta.atelierTitle} description={s.meta.atelierDesc} alternates={allLangs((l) => pagePath('atelier', l))}
  section="atelier" breadcrumbs={[{ name: s.nav.atelier, path: pagePath('atelier', lang) }]} extraLd={ld} ogPhoto="atelier-dinner-from-above" enquiry={{ page: 'atelier', cta: 'line', photo: 'private-dining-bowls', tone: 'terracotta', side: 'right', preset: 4 }}>
  <PageHero lang={lang} label={s.nav.atelier} title={a.title} lead={a.lead} cover="atelier-dinner-from-above" photo="atelier-from-above">
    <a class="line-link" href={`${pagePath('quote', lang)}?type=4`}>{s.catering.cta}</a>
  </PageHero>
  <section class="pad stone"><div class="wrap">
  <div class="duo">
    <h2>{a.introTitle}</h2>
    <div>{a.intro.map((p) => <p class="para">{p}</p>)}
      <p class="contacts"><a href={site.mapUrl} target="_blank" rel="noopener">{site.address.street}, {site.address.postalCode} {site.address.city}</a></p></div>
  </div>
    <ul class="grid after" role="list" style="--n:4">{(['atelier-dining-room', 'chef-plating', 'apron-details', 'ready-to-serve'] as const).map((k) => <li><Photo name={k} lang={lang} ratio="3/4" sizes="(min-width: 1300px) 285px, (min-width: 800px) 23vw, 46vw" /></li>)}</ul>
  </div></section>
  <section class="pad wrap duo"><h2>{s.catering.faqTitle}</h2><Faq items={a.faq} /></section>
</Base>
