---
// Pages légales : mentions légales et politique de confidentialité (texte simple, sans bandeau final).
import Base from '../layouts/Base.astro';
import { legalNotice, privacyPolicy, updated } from '../lib/legal';
import { pagePath, anchorId, allLangs } from '../i18n/routes';
import { L as Lx, type Lang } from '../i18n/locales';
interface Props { lang: Lang }
const { lang } = Astro.props;
const docs = [{ ...legalNotice[lang], id: undefined }, { ...privacyPolicy[lang], id: anchorId('privacy', lang) }];
const L = Lx(lang);
const desc = L('Juridische informatie en privacybeleid van BEAU MOMENTS VOF, Maldegem: ondernemingsgegevens, hosting, verwerking van persoonsgegevens en je rechten.', 'Mentions légales et politique de confidentialité de BEAU MOMENTS, Maldegem : entreprise, hébergement, données personnelles et vos droits.', 'Legal notice and privacy policy of BEAU MOMENTS, Maldegem: company details, hosting, personal data and your rights.');
---
<Base lang={lang} title={`${docs[0].title} — BEAU MOMENTS`} description={desc} alternates={allLangs((l) => pagePath('legal', l))}
  breadcrumbs={[{ name: docs[0].title, path: pagePath('legal', lang) }]}>
  <section class="phead"><div class="wrap"><h1>{docs[0].title}</h1></div></section>
  <section class="wrap pad legal">
    {docs.map((doc, n) => (
      <div id={doc.id} class="legal-doc">
        {n > 0 && <h2 class="legal-title">{doc.title}</h2>}
        <p class="lead">{doc.intro}</p>
        {doc.blocks.map((b) => (
          <div class="legal-block">
            {n > 0 ? <h3>{b.h}</h3> : <h2>{b.h}</h2>}
            <div>
              {b.p?.map((t) => <p>{t}</p>)}
              {b.list && <ul>{b.list.map((t) => <li>{t}</li>)}</ul>}
            </div>
          </div>
        ))}
      </div>
    ))}
    <p class="legal-updated">{L('Laatst bijgewerkt', 'Dernière mise à jour', 'Last updated')}: {updated[lang]}</p>
  </section>
</Base>
