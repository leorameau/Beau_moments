---
// Galerie : toutes les photos Instagram en rangées justifiées, sans recadrage ; filtre par chapitre, clic = visionneuse.
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { getImage } from 'astro:assets';
import { getPhoto, type PhotoKey } from '../lib/photos';
import { site, abs } from '../lib/site';
import { pagePath, allLangs } from '../i18n/routes';
import { localeInfo, L as Lx, type Lang } from '../i18n/locales';
import { t } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const ig = site.social.instagram;
const L = Lx(lang);

const chapters: { id: string; title: string; photos: PhotoKey[] }[] = [
  { id: 'gerechten', title: L('Op het bord', 'Dans l’assiette', 'On the plate'),
    photos: ['lobster-caviar', 'caviar-dish', 'egg-shrimp-tray', 'langoustine', 'hamachi', 'scallop-dish', 'lobster-sauce', 'oysters', 'european-lobster', 'langoustine-ceviche', 'side-dish', 'strawberry-dessert', 'dame-blanche', 'hazelnut-tart'] },
  { id: 'atelier', title: L('Het atelier', 'L’atelier', 'The atelier'),
    photos: ['atelier-facade', 'atelier-dinner-from-above', 'atelier-dining-room', 'atelier-candles'] },
  { id: 'tafels', title: L('Gedekte tafels', 'Tables dressées', 'Laid tables'),
    photos: ['table-room', 'table-lemons', 'valentine-table', 'table-long', 'garden-table', 'table-flowers', 'valentine-barn', 'table-candles', 'flowers'] },
  { id: 'receptie', title: L('Hapjes & receptie', 'Bouchées & réception', 'Canapés & receptions'),
    photos: ['appetizers', 'flower-bites', 'egg-shrimp-garden', 'tartelettes', 'waiter-tray'] },
  { id: 'producten', title: L('Producten', 'Les produits', 'The produce'),
    photos: ['scallops', 'beef-cuts', 'olive-oil-tasting'] },
  { id: 'achter-de-schermen', title: L('Achter de schermen', 'En coulisses', 'Behind the scenes'),
    photos: ['plating-sauce', 'chef-plating', 'kitchen-beef', 'bert-serving', 'apron-details', 'ready-to-serve', 'bites-tray', 'champagne-bar', 'behind-the-curtain', 'amuse-spoons'] },
  { id: 'bubbels', title: L('Bubbels & aperitief', 'Bulles & apéritif', 'Bubbles & aperitif'),
    photos: ['awa-shiso-ice', 'awa-shiso-bottle', 'apero', 'croquettes'] },
  { id: 'momenten', title: L('Momenten', 'Moments', 'Moments'),
    photos: ['bert-and-aude', 'aude-with-guests', 'serving-bubbles'] },
];

// Version grand format pour la visionneuse (jusqu'à la pleine résolution de l'original)
const all = chapters.flatMap((c) => c.photos);
const full = Object.fromEntries(await Promise.all(all.map(async (k) => {
  const src = getPhoto(k).src;
  const img = await getImage({ src, width: Math.min(1300, src.width), format: 'webp', quality: 80 });
  return [k, img.src];
})));

const ld = [{
  '@type': 'ImageGallery',
  name: s.gallery.title,
  inLanguage: localeInfo[lang].html,
  url: abs(pagePath('gallery', lang)),
  author: { '@id': `${site.siteUrl}/#business` },
  image: all.map((k) => ({ '@type': 'ImageObject', contentUrl: abs(full[k]), caption: getPhoto(k).alt[lang] })),
}];
---
<Base lang={lang} title={s.meta.galleryTitle} description={s.meta.galleryDesc} alternates={allLangs((l) => pagePath('gallery', l))}
  section="gallery" breadcrumbs={[{ name: s.nav.gallery, path: pagePath('gallery', lang) }]} extraLd={ld} ogPhoto="table-candles" enquiry={{ look: 'c', photo: 'table-long' }}>
  <section class="phead"><div class="wrap">
    <h1>{s.gallery.title}</h1>
    <p class="lead">{s.gallery.lead}</p>
    <div class="chips" data-chips hidden>
      <button type="button" aria-pressed="true" data-f="">{L('Alles', 'Tout', 'All')}</button>
      {chapters.map((c) => <button type="button" aria-pressed="false" data-f={c.id}>{c.title}</button>)}
    </div>
  </div></section>
  <section class="wrap"><h2 class="sr">{s.nav.gallery}</h2><div class="wall">
    {chapters.flatMap((c) => c.photos.map((k) => <div class="brick" data-ch={c.id} style={`--k:${(getPhoto(k).src.width / getPhoto(k).src.height).toFixed(4)}`}><Photo zoom name={k} lang={lang} sizes="(min-width: 900px) 30vw, 48vw" /></div>))}
  </div></section>
</Base>
<script>
  const chips = document.querySelector<HTMLElement>('[data-chips]')!;
  chips.hidden = false;
  chips.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (!b) return;
    chips.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll<HTMLElement>('.brick').forEach((el) => { el.hidden = !!b.dataset.f && el.dataset.ch !== b.dataset.f; });
  });
</script>
