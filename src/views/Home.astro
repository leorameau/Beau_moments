---
// Accueil : ouverture en boucle, puis l'ordre du menu (Over ons, Ons aanbod, Galerij, Atelier, Afhaal), les avis et la demande.
import Base from '../layouts/Base.astro';
import { feest } from '../lib/feestdagen';
import { reviews, googleRating, googleReviewsUrl } from '../lib/reviews';
import { getPhoto, type PhotoKey } from '../lib/photos';
import { pagePath, eventPath, allLangs } from '../i18n/routes';
import { t } from '../i18n/ui';
import { L as Lx, localeInfo, type Lang } from '../i18n/locales';
import Photo from '../components/Photo.astro';
import Logo from '../components/Logo.astro';
import { eventTypes } from '../lib/events';
import { nbsp } from '../lib/nbsp';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const f = feest[lang];
const h = s.home;
const L = Lx(lang);
// Ouverture : trois panneaux verticaux (photos en couleur et en hauteur : plats, tables, décor) ; dans chacun, trois photos en boucle
const panels: PhotoKey[][] = [
  ['caviar-dish', 'garden-table', 'hamachi'],
  ['valentine-table', 'strawberry-dessert', 'atelier-dining-room'],
  ['side-dish', 'atelier-from-above', 'table-candles'],
];
// Galerie : sujets variés, en rangées justifiées sans recadrage
const gallery: PhotoKey[] = ['aude-at-work', 'kitchen-beef', 'croquettes', 'apero', 'valentine-barn', 'hazelnut-tart', 'oysters', 'awa-shiso-ice'];
const offers = [
  ...eventTypes.map((e) => ({ name: e.copy[lang].name, href: eventPath(e.key, lang) })),
  { name: h.privateLabel, href: pagePath('atelier', lang) },
  { name: s.nav.takeaway, href: pagePath('takeaway', lang) },
];
// Ons aanbod : le service, une table dressée chez le client et des bouchées de réception
const ar = (k: PhotoKey) => getPhoto(k).src.width / getPhoto(k).src.height;
const offerSide: PhotoKey[] = ['table-room', 'appetizers'];
const trioSizes = '(min-width: 1000px) 34vw, 62vw';
const half = '(min-width: 640px) 46vw, 92vw';
// Trois avis Google, sans celui qui contient un emoji
const shownReviews = reviews.filter((r) => !/\p{Extended_Pictographic}/u.test(r.quote.nl)).slice(0, 3);
---
<Base lang={lang} title={s.meta.homeTitle} description={s.meta.homeDesc} alternates={allLangs((l) => pagePath('home', l))} ogPhoto="table-room" enquiry={{ look: 'b' }}>
  <section class="hero hero-home">
    <div class="panels">
      {panels.map((col, c) => (
        <div class="panel">{col.map((k, i) => <Photo name={k} lang={lang} eager={c === 0 && i === 0} class="slide" quality={90} style={`--i:${i};--c:${c}`} sizes="(max-aspect-ratio: 1/1) max(100vw, 62vh), (max-aspect-ratio: 17/10) max(50vw, 78vh), max(34vw, 78vh)" />)}</div>
      ))}
    </div>
    <Logo />
    <h1 class="sr">Beau Moments — {L('Catering & private dining in Maldegem', 'Catering & private dining à Maldegem', 'Catering & private dining in Maldegem')}</h1>
  </section>

  <!-- Over ons -->
  <section class="pad wrap">
    <p class="lede line head">{nbsp(h.heroLead)}</p>
    <div class="split">
      <Photo name="bert-and-aude" lang={lang} sizes={half} />
      <div><h2>{s.nav.about}</h2><p>{h.aboutText}</p><p class="acts"><a class="btn" href={pagePath('about', lang)}>{h.aboutMore}</a></p></div>
    </div>
  </section>

  <!-- Ons aanbod -->
  <section class="pad stone"><div class="wrap split flip">
    <div class="trio">
      <div style={`--k:${ar('ready-to-serve')}`}><Photo name="ready-to-serve" lang={lang} sizes={trioSizes} /></div>
      <div style={`--k:${1 / offerSide.reduce((n, k) => n + 1 / ar(k), 0)}`}>{offerSide.map((k) => <Photo name={k} lang={lang} sizes={trioSizes} />)}</div>
    </div>
    <div>
      <h2>{s.nav.catering}</h2>
      <p>{L('Catering, private dining en events, met klassieke Franse keuken.', 'Traiteur, private dining et événements, en cuisine française classique.', 'Catering, private dining and events, with classic French cooking.')}</p>
      <ul class="offer-list" role="list">{offers.map((o) => <li><a href={o.href}>{o.name}<span aria-hidden="true">→</span></a></li>)}</ul>
      <p class="acts"><a class="btn" href={pagePath('catering', lang)}>{L('Ontdek ons aanbod', 'Voir nos services', 'See what we do')}</a></p>
    </div>
  </div></section>

  <!-- Atelier -->
  <section class="pad wrap"><div class="split">
    <Photo name="atelier-facade" lang={lang} sizes={half} />
    <div><h2>{s.nav.atelier}</h2><p>{h.atelierText}</p><p class="acts"><a class="btn" href={pagePath('atelier', lang)}>{L('Ontdek het atelier', 'Découvrir l’atelier', 'Discover the atelier')}</a></p></div>
  </div></section>

  <!-- Galerij -->
  <section class="pad stone"><div class="wrap">
    <div class="head"><h2>{s.nav.gallery}</h2><p class="under">{h.galleryLead}</p></div>
    <div class="rows">{[0, 4].map((r) => (
      <div class="row">{[r, r + 2].map((q) => (
        <div class="two-up">{gallery.slice(q, q + 2).map((k) => <div style={`flex:${(getPhoto(k).src.width / getPhoto(k).src.height).toFixed(4)} 1 0`}><Photo name={k} lang={lang} zoom sizes="(min-width: 640px) 32vw, 60vw" /></div>)}</div>
      ))}</div>
    ))}</div>
    <p class="acts"><a class="btn" href={pagePath('gallery', lang)}>{h.galleryAll}</a></p>
  </div></section>

  <!-- Afhaal -->
  <section class="pad wrap"><div class="split flip">
    <Photo name="feest-cover" lang={lang} sizes={half} />
    <div><h2>{f.label}</h2><p>{f.lead}</p><p class="small">{f.deadline}</p><p class="small">{f.allergens}</p><p class="acts"><a class="btn" href={`${pagePath('takeaway', lang)}#feestdagen`}>{L('Bekijk het menu', 'Voir le menu', 'See the menu')}</a></p></div>
  </div></section>

  <section class="pad stone guests"><div class="wrap">
    <div class="head"><h2>{h.reviewsTitle}</h2><p>{googleRating.score.toLocaleString(localeInfo[lang].html)} / 5 · {h.googleCount.replace('{n}', String(googleRating.count))}</p></div>
    <ul role="list">
      {shownReviews.map((r) => (
        <li><h3>{r.author}</h3><span class="stars" role="img" aria-label={`${r.stars}/5`}>{'★'.repeat(r.stars)}{'☆'.repeat(5 - r.stars)}</span><p>{r.quote[lang]}</p></li>
      ))}
    </ul>
    <a class="btn" href={googleReviewsUrl} target="_blank" rel="noopener">{h.reviewsAll}</a>
  </div></section>

</Base>
